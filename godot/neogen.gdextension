; Neogen GDExtension manifest.
; Artifacts in godot/bin/ are built (not committed); see README «Версии».

[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"

[libraries]

windows.debug.x86_64 = "res://bin/neogen_gdext.windows.x86_64.dll"
windows.release.x86_64 = "res://bin/neogen_gdext.windows.x86_64.dll"

linux.debug.x86_64 = "res://bin/libneogen_gdext.linux.x86_64.so"
linux.release.x86_64 = "res://bin/libneogen_gdext.linux.x86_64.so"

macos.debug = "res://bin/libneogen_gdext.macos.dylib"
macos.release = "res://bin/libneogen_gdext.macos.dylib"
